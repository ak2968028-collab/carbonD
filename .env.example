# Copy to .env. Host ports are checked/updated automatically by check-ports.sh
FRONTEND_PORT=3200
BACKEND_PORT=7200
DB_PORT=5460
GEOSERVER_PORT=8095

# ---------------------------------------------------------------------------------------------
# Public access (Cloudflare tunnel): NO domain or token needed.
#   docker compose runs a quick tunnel: https://<random>.trycloudflare.com -> gateway (nginx)
#     https://<random>.trycloudflare.com/api/...        -> backend
#     https://<random>.trycloudflare.com/geoserver/...  -> GeoServer map services (WMS/WFS/tiles)
#   ./tunnel-links.sh prints the link and writes frontend/.env.local.
#   The random link changes when the cloudflared container restarts (e.g. after a reboot);
#   then run ./tunnel-links.sh again and update the two NEXT_PUBLIC_* values in Vercel.
#
# Optional, only if you later add your own domain to Cloudflare (for a link that never changes):
#   Zero Trust (https://one.dash.cloudflare.com) > Networks > Tunnels > Create a tunnel > Cloudflared
#   > Docker: copy the value after --token into CLOUDFLARE_TUNNEL_TOKEN; add ONE public hostname
#   (e.g. carbon.<your-domain>) -> HTTP -> gateway:80; set PUBLIC_URL to it; and in
#   docker-compose.yml switch cloudflared to `tunnel --no-autoupdate run` with TUNNEL_TOKEN.
# ---------------------------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_URL=
